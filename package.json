{
  "name": "moltworld-robinhood-wif",
  "version": "1.0.0",
  "description": "Moltworld: pay-per-request AI gateway with x402 WIF settlement on Robinhood Chain",
  "repository": {
    "type": "git",
    "url": "https://github.com/devndesigner6/moltworld-robinhood-wif.git"
  },
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx scripts/build-vendor.ts && tsx src/server.ts",
    "dev": "tsx scripts/build-vendor.ts && tsx watch src/server.ts",
    "test": "vitest run",
    "test:client": "tsx src/client/testClient.ts",
    "test:settle": "tsx scripts/setupAndSettleTestnet.ts",
    "build": "tsx scripts/build-vendor.ts && tsc && tsc -p sdk/js/tsconfig.json --noEmit",
    "start:prod": "node dist/server.js",
    "deploy:contabo": "bash scripts/deploy.sh",
    "mainnet:wallet": "tsx scripts/manageMainnetMerchant.ts",
    "stack:local": "tsx scripts/build-vendor.ts && tsx scripts/local-stack.ts",
    "typecheck": "tsc --noEmit && tsc -p sdk/js/tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test:ui": "tsx scripts/build-vendor.ts && node tests/ui/run.mjs",
    "vendor": "tsx scripts/build-vendor.ts",
    "brand": "node scripts/render-brand.mjs",
    "mandate:counter": "tsx scripts/deployMandateCounter.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@txnlab/use-wallet": "5.1.1",
    "@txnlab/use-wallet-defly": "5.1.1",
    "@txnlab/use-wallet-kibisis": "5.1.1",
    "@txnlab/use-wallet-lute": "5.0.0",
    "@txnlab/use-wallet-pera": "5.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "typegpu": "0.12.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.42",
    "@electric-sql/pglite": "^0.5.11",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "^2.2.0",
    "@x402-avm/extensions": "^2.6.1",
    "@x402/avm": "^2.27.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "@x402/hono": "^2.27.0",
    "algosdk": "^3.8.0",
    "dotenv": "^18.0.3",
    "hono": "^4.13.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "undici": "^8.12.3",
    "viem": "^2.57.16",
    "zod": "^4.6.5"
  }
}
