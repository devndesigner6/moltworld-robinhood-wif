# Robinhood Chain production template for the migrated pay-per-call gateway.
# Never put wallet private keys, seed phrases, provider API keys, or database
# passwords in Git. Add secrets directly in Render's environment settings.
NODE_ENV=production
PAYMENT_CHAIN=robinhood
ROBINHOOD_NETWORK=mainnet

# Public recipient wallet: every x402 WIF settlement is sent here. This is an
# address only; the backend never needs its private key.
EVM_ADDRESS=0x0cbF84496640E7441eF743f8F03189Aa8C0B8cb6

# Public WIF ERC-20 contract on Robinhood Chain mainnet (18 decimals).
WIF_TOKEN_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773
# Must allow eth_call/balanceOf from the Render service. Replace with a provider
# URL/API key if the public endpoint returns 403 from the deployed environment.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
FACILITATOR_URL=https://x402.primer.systems
# Public site origin. Vercel proxies this hostname to the Render backend.
# Keep Render x402 challenges, receipts and canonical URLs on this public origin.
PUBLIC_DOMAIN=https://motoworld-wif.vercel.app
DOCS_URL=https://docs.moltworld.xyz

# WIF/USD pricing source: DexScreener live pool data with GeckoTerminal fallback
# for the same exact pool. Brief validated snapshots are cached; old/low-liquidity
# data fails closed. This is a price feed, not an on-chain oracle.
WIF_PRICE_URL=https://api.dexscreener.com/latest/dex/pairs/robinhood/0x71ef4106340f0a3b9c19ec994eef4fc44a1d2513f38faac39d7636b156548c79
WIF_PRICE_MIN_LIQUIDITY_USD=25000
WIF_PRICE_HAIRCUT_BPS=500

# Required production persistence and receipt signing secrets.
DATABASE_URL=
REDIS_URL=
RECEIPT_SIGNING_KEY=
RECEIPT_PREVIOUS_PUBLIC_KEYS=
ADMIN_TOKEN=

# Real upstream provider keys. At least one configured provider must expose
# supported chat models; unset providers are not advertised as available.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Live provider pricing controls and operational limits.
PRICE_MARGIN=0.03
PRICE_MIN_FLOOR=0.001
MAX_INFLIGHT_PER_PAYER=4
MOCK_PROVIDERS=false
SKIP_UPSTREAM_VERIFICATION=false
BACKGROUND_WORKERS=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
PORT=3000

# Robinhood Chain WIF payments are currently enabled for chat only. The legacy
# Algorand marketplace, mandates, and USDC refund/payout workers are disabled.
# First-time users may need to approve an exact WIF allowance to Permit2; that
# one-time approval consumes a small amount of native ETH for gas.
