{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://motoworld-wif.onrender.com/"
    },
    {
      "source": "/:path*",
      "destination": "https://motoworld-wif.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "src/index.ts": {
      "includeFiles": "vendor/**"
    }
  }
}
